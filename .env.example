# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Database: leave unset for local SQLite, or use PostgreSQL in deployments.
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# Store media and email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.invalid

# Kavenegar: add the real API key and template name before enabling OTP login.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_TIMEOUT=8
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PHONE_LIMIT_PER_HOUR=5
OTP_IP_LIMIT_PER_HOUR=20
OTP_VERIFY_PHONE_LIMIT_PER_HOUR=15
OTP_VERIFY_IP_LIMIT_PER_HOUR=40

# ZarinPal: sandbox is selected by default while DEBUG=True.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
ZARINPAL_API_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_PAYMENT_BASE_URL=https://sandbox.zarinpal.com/pg/StartPay/
# Verify the unit expected by the merchant account before production.
ZARINPAL_TOMAN_TO_RIAL=10
ZARINPAL_TIMEOUT=10
PAYMENT_RESERVATION_SECONDS=1800

# Development: with DJANGO_DEBUG=true and no API key, print OTP codes in the server console.
OTP_CONSOLE_FALLBACK=true

PRIVATE_MEDIA_ROOT=
DIGITAL_MAX_UPLOAD_MB=200
DIGITAL_DOWNLOAD_LIMIT=5
