{
  "name": "astrostore-assets",
  "private": true,
  "scripts": {
    "build:fonts": "node scripts/copy-fonts.mjs",
    "build:css": "npx @tailwindcss/cli -i astrostore/static/css/tailwind.input.css -o astrostore/static/css/tailwind.generated.css --minify",
    "build": "npm run build:fonts && npm run build:css",
    "watch:css": "npx @tailwindcss/cli -i astrostore/static/css/tailwind.input.css -o astrostore/static/css/tailwind.generated.css --watch"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
}
